<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Task Manager</title>

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <!-- <link rel="stylesheet" href="/stylesheets/style.css"> -->
</head>

<body>

    <div class="main w-full min-h-screen bg-zinc-900">

        <!-- Form -->
        <div class="form p-10 text-white">
            <form action="/create" method="POST">
                <input class="block px-5 py-2 bg-zinc-800 w-full rounded-md outline-none text-white" type="text"
                    placeholder="Title goes here" name="title">

                <textarea class="block mt-2 px-5 py-2 bg-zinc-800 rounded-md w-full resize-none outline-none text-white"
                    placeholder="Description goes here" name="details"></textarea>

                <input class="mt-2 bg-blue-600 px-5 py-2 rounded-md cursor-pointer hover:bg-blue-700" type="submit"
                    value="Add Task">
            </form>
        </div>

        <!-- Tasks Container -->
        <div class="tasks  p-10 flex gap-3 flex-wrap items-start">

            <%if(files.length>0){%>

                <% files.forEach(function(val){ %>



                    <div class="  min-w-72 h-64 shrink-0 px-3 py-4 bg-zinc-800 rounded-md">
                        <h1 class="text-white text-3xl tracking-tighter">
                            <%=val%>
                        </h1>
                        <div class="flex w-full justify-between items-center mt-3">
                            <a class="text-blue-500 inline-block  hover:text-blue-400" href="/files/<%=val%>">
                                View Details
                            </a>

                            <a class="text-zinc-600 hover:text-white" href="/edit/<%= val %>">
                                Edit Filename
                            </a>

                        </div>

                    </div>

                    <% })%>
                        <% } else { %>
                            <h1 class="text-zinc-600">No Tasks Yet...</h1>
                            <%}%>

        </div>

    </div>

    <script src="/javascripts/script.js"></script>

</body>

</html>